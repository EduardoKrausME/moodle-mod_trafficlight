{{!
    @template mod_trafficlight/student_form

    Example context (json):
    {
        *Example context (json):*
    }
}}
<div class="trafficlight-student" role="region" aria-labelledby="trafficlight-title">
    <h3 id="trafficlight-title" class="h4 mb-3">{{#str}} chooseyourstatus, mod_trafficlight {{/str}}</h3>

    <form method="post" action="{{action}}" class="trafficlight-choice-form">
        <input type="hidden" name="sesskey" value="{{sesskey}}">
        <input type="hidden" name="submitresponse" value="1">

        <div class="trafficlight-choices">
            <button type="submit" name="status" value="green"
                    class="trafficlight-choice trafficlight-choice-green {{#green}}is-selected{{/green}}"
                    aria-pressed="{{#green}}true{{/green}}{{^green}}false{{/green}}">
                <span class="trafficlight-lamp" aria-hidden="true"></span>
                <span class="trafficlight-choice-text">
                    <strong>{{#str}} statusgreen, mod_trafficlight {{/str}}</strong>
                    <span>{{#str}} statusgreendescription, mod_trafficlight {{/str}}</span>
                </span>
            </button>

            <button type="submit" name="status" value="yellow"
                    class="trafficlight-choice trafficlight-choice-yellow {{#yellow}}is-selected{{/yellow}}"
                    aria-pressed="{{#yellow}}true{{/yellow}}{{^yellow}}false{{/yellow}}">
                <span class="trafficlight-lamp" aria-hidden="true"></span>
                <span class="trafficlight-choice-text">
                    <strong>{{#str}} statusyellow, mod_trafficlight {{/str}}</strong>
                    <span>{{#str}} statusyellowdescription, mod_trafficlight {{/str}}</span>
                </span>
            </button>

            <button type="submit" name="status" value="red"
                    class="trafficlight-choice trafficlight-choice-red {{#red}}is-selected{{/red}}"
                    aria-pressed="{{#red}}true{{/red}}{{^red}}false{{/red}}">
                <span class="trafficlight-lamp" aria-hidden="true"></span>
                <span class="trafficlight-choice-text">
                    <strong>{{#str}} statusred, mod_trafficlight {{/str}}</strong>
                    <span>{{#str}} statusreddescription, mod_trafficlight {{/str}}</span>
                </span>
            </button>
        </div>
    </form>

    <p class="text-muted mt-3 mb-0">{{#str}} changeanytime, mod_trafficlight {{/str}}</p>
</div>
